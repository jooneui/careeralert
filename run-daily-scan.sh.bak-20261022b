#!/bin/zsh
set -euo pipefail

VAULT_DIR="/Users/jooneuihong/Library/CloudStorage/OneDrive-UCIrvine/06 Obisidian/05 Career"
SCAN_DATE="$(date +%Y-%m-%d)"
SCAN_STARTED="$(date +%s)"
LOG_FILE="$VAULT_DIR/automation/logs/$SCAN_DATE.log"
PROMPT_FILE="$VAULT_DIR/automation/daily-scan-prompt.md"
DIGEST_FILE="$VAULT_DIR/automation/digests/$SCAN_DATE.md"
CLAUDE_BIN="/Users/jooneuihong/.local/bin/claude"

cd "$VAULT_DIR"

"$CLAUDE_BIN" -p "$(cat "$PROMPT_FILE")" \
  --model claude-sonnet-5 \
  --permission-mode acceptEdits \
  --permission-prompts none \
  --allowedTools "WebSearch WebFetch Read Write Edit Glob Grep" \
  --no-session-persistence \
  >> "$LOG_FILE" 2>&1 || SCAN_STATUS=$?

SCAN_STATUS=${SCAN_STATUS:-0}
if [[ $SCAN_STATUS -ne 0 ]]; then
  echo "ERROR: scan exited $SCAN_STATUS; dashboard was not rebuilt" >> "$LOG_FILE"
  exit $SCAN_STATUS
fi

# A successful scan must leave a dated digest, including when it found nothing.
if [[ ! -s "$DIGEST_FILE" ]] || (( $(stat -f %m "$DIGEST_FILE") < SCAN_STARTED )); then
  echo "ERROR: scan returned success without writing a fresh digest for $SCAN_DATE" >> "$LOG_FILE"
  exit 1
fi

# Keep the AI feed separate so an AI source failure does not discard a
# successful career scan. Its latest successful digest stays visible.
AI_SCAN_STATUS=0
/bin/zsh "$VAULT_DIR/automation/run-ai-watch.sh" >> "$LOG_FILE" 2>&1 || AI_SCAN_STATUS=$?
if [[ $AI_SCAN_STATUS -ne 0 ]]; then
  echo "WARNING: AI Watch scan exited $AI_SCAN_STATUS; showing its last successful digest" >> "$LOG_FILE"
fi

# Transportation News runs the same way: a failure keeps its last digest visible.
NEWS_SCAN_STATUS=0
/bin/zsh "$VAULT_DIR/automation/run-transport-news.sh" >> "$LOG_FILE" 2>&1 || NEWS_SCAN_STATUS=$?
if [[ $NEWS_SCAN_STATUS -ne 0 ]]; then
  echo "WARNING: Transportation News scan exited $NEWS_SCAN_STATUS; showing its last successful digest" >> "$LOG_FILE"
fi

# Rebuild the browsable HTML dashboard from all digests (deterministic, no network).
/usr/bin/python3 "$VAULT_DIR/automation/build-digest-html.py" >> "$LOG_FILE" 2>&1

# Send one daily completion notification, including days with no new items.
NOTICE="Career, AI Watch and news scans complete; open Career Alerts for results"
if [[ $AI_SCAN_STATUS -ne 0 && $NEWS_SCAN_STATUS -ne 0 ]]; then
  NOTICE="Career scan complete; AI Watch and Transportation News need attention"
elif [[ $AI_SCAN_STATUS -ne 0 ]]; then
  NOTICE="Career and news scans complete; AI Watch needs attention"
elif [[ $NEWS_SCAN_STATUS -ne 0 ]]; then
  NOTICE="Career and AI scans complete; Transportation News needs attention"
fi
/usr/bin/osascript -e "display notification \"$NOTICE\" with title \"Career Alerts\"" >> "$LOG_FILE" 2>&1 || echo "WARNING: notification could not be sent" >> "$LOG_FILE"
